#!/bin/sh
# ============================================================================
# commit-msg 钩子：自动在提交信息首行开头插入当前日期时间
# 格式：YYYY-MM-DD HH:MM:SS
# 触发：所有提交路径（git commit / git commit -m / --amend / merge / squash）
# 特性：
#   1. 不依赖手动输入，每次提交自动触发
#   2. 仅修改首行开头，不影响提交信息的其余内容（正文、注释等）
#   3. 幂等：若首行已有时间戳（如 --amend 复用信息），先剥离再重新插入，
#      不会出现重复时间戳
#   4. 跳过纯注释/空行，仅作用于第一条真实提交信息行
# ============================================================================

# Git 将提交信息临时文件路径作为第一个参数传入
MSG_FILE="$1"

# 无参数时直接放行（防御性处理）
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

# 获取当前时间戳（精确到秒）。POSIX date，Git Bash / Linux / macOS 均支持
TS=$(date +"%Y-%m-%d %H:%M:%S")

# 临时文件（与信息文件同目录，避免跨文件系统问题）
TMP_FILE="${MSG_FILE}.ts_tmp.$$"

awk -v ts="$TS" '
  BEGIN { inserted = 0 }
  {
    # 仅对第一条“非注释且非空”的真实提交行插入时间戳
    if (!inserted && $0 !~ /^#/ && $0 !~ /^[[:space:]]*$/) {
      line = $0
      # 剥离该行已有的前导时间戳，保证 amend 时幂等、不重复
      sub(/^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]*/, "", line)
      print ts " " line
      inserted = 1
    } else {
      print $0
    }
  }
' "$MSG_FILE" > "$TMP_FILE"

# 写回（仅在成功生成后替换）
if [ -s "$TMP_FILE" ]; then
  mv "$TMP_FILE" "$MSG_FILE"
else
  rm -f "$TMP_FILE"
fi

exit 0
