{
  "version": "2.1",
  "name": "EQiSmart AI Coach 健身产品测试用例 V1.0 · 软件版（2410 条 / 15 模块 / 三分类）",
  "description": "四层排序：分类（公共→横屏专项→竖屏专项）→ 阶段 → 模块 → 测试点。业务主线：账号准备(移动端注册/登录) → 设备接入(启动/登录) → 首次引导与C00校准 → 核心训练(首页/课程库/训练/自由跑/训练记录) → 语音与智能助手(语音/AI教练) → 设置维护(个人中心/国际化/休眠)。",
  "partition": {
    "column": "设备型号",
    "order": [
      "公共",
      "横屏专项",
      "竖屏专项"
    ],
    "default": "公共"
  },
  "stages": [
    {
      "name": "S1 账号准备（移动端）",
      "modules": [
        "移动端-注册",
        "移动端-登录"
      ]
    },
    {
      "name": "S2 设备接入",
      "modules": [
        "设备端-启动",
        "设备端-登录"
      ]
    },
    {
      "name": "S3 首次引导与基线校准",
      "modules": [
        "设备端-引导"
      ]
    },
    {
      "name": "S4 核心训练闭环",
      "modules": [
        "设备端-首页",
        "设备端-训练课程库",
        "设备端-训练",
        "设备端-自由跑",
        "设备端-训练记录"
      ]
    },
    {
      "name": "S5 语音与智能助手",
      "modules": [
        "设备端-语音",
        "设备端-AI教练"
      ]
    },
    {
      "name": "S6 设置维护与国际化",
      "modules": [
        "设备端-个人中心",
        "设备端-国际化",
        "设备端-休眠"
      ]
    }
  ],
  "module_sequence": [
    "移动端-注册",
    "移动端-登录",
    "设备端-启动",
    "设备端-登录",
    "设备端-引导",
    "设备端-首页",
    "设备端-训练课程库",
    "设备端-训练",
    "设备端-自由跑",
    "设备端-训练记录",
    "设备端-语音",
    "设备端-AI教练",
    "设备端-个人中心",
    "设备端-国际化",
    "设备端-休眠"
  ],
  "module_options": {
    "设备端-引导": {
      "fallback": "nearest"
    }
  },
