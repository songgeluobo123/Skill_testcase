  "testpoint_rules": {
    "APP-登录": [
      {
        "group": "01 一键登录界面与入口",
        "match": [
          "一键登录界面",
          "进入一键登录",
          "其它登录方式",
          "APP图标"
        ]
      },
      {
        "group": "02 一键登录主流程",
        "match": [
          "本机号码一键登录",
          "一键登录功能",
          "未注册点击一键登录",
          "运营商"
        ]
      },
      {
        "group": "03 运营商等价类",
        "match": [
          "中国移动",
          "中国联通",
          "中国电信"
        ]
      },
      {
        "group": "04 Tab切换（验证码/密码）",
        "match": [
          "Tab",
          "验证码界面点击一键登录",
          "界面频繁切换"
        ]
      },
      {
        "group": "05 验证码登录与按钮态",
        "match": [
          "验证码登录",
          "获取验证码按钮",
          "登录按钮可用",
          "登录按钮应置灰",
          "输入框占位符"
        ]
      },
      {
        "group": "06 密码登录与校验",
        "match": [
          "密码登录",
          "密码应隐藏",
          "密码输入错误",
          "忘记密码",
          "密码位数",
          "空位密码",
          "全英文字符",
          "全数字字符",
          "特殊字符"
        ]
      },
      {
        "group": "07 邮箱登录与第三方",
        "match": [
          "邮箱登录",
          "Google",
          "苹果",
          "第三方登录"
        ]
