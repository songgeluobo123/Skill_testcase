{
  "version": "2.2",
  "name": "EQi 智能出行 · 测试用例管理库（1278 条 / 4 顶级模块 / 19 功能模块）",
  "description": "以《测试用例管理.xlsx》体现的排序策略为基准：两级模块分组（顶级功能模块 → 功能模块）+ 模块内测试点顺序 + 组内原始顺序保序。类型/优先级是属性，默认不参与排序（原库实证：模块内类型交错、优先级不单调）。",
  "partition": {
    "column": "设备型号",
    "order": [
      "公共",
      "BB2",
      "BB3"
    ],
    "default": "公共"
  },
  "top_module_sequence": [
    "APP",
    "嵌入式固件",
    "联调功能",
    "系统后台"
  ],
  "top_module_mode": "sub",
  "priority_order": [
    "P0",
    "P1",
    "P2",
    "P3",
    "P4"
  ],
  "sort_by_priority": false,
  "stages": [
    {
      "name": "S1 APP 账号与准入",
      "modules": [
        "APP-启动",
        "APP-登录",
        "APP-手机号",
        "APP-协议书",
        "APP-验证码",
        "APP-重置密码",
        "APP-注册",
        "APP-邮箱",
        "APP-注销"
      ]
    },
    {
      "name": "S2 设备接入与配对",
      "modules": [
        "APP-设备配对与绑定",
        "设备状态与设置"
      ]
    },
    {
      "name": "S3 升级链路（固件 + APP）",
      "modules": [
        "OTA",
        "APP-设置",
        "APP-版本更新",
        "APP-下载",
        "APP-安装"
      ]
    },
    {
      "name": "S4 账号与个人管理",
      "modules": [
        "个人中心"
      ]
    },
    {
      "name": "S5 后台与数据",
      "modules": [
        "IOT系统-物模型数据",
        ""
      ]
    }
  ],
  "module_sequence": [
    "APP-启动",
    "APP-登录",
    "APP-手机号",
    "APP-协议书",
    "APP-验证码",
    "APP-重置密码",
