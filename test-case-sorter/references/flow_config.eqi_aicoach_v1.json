{
  "version": "2.0",
  "name": "EQiSmart AI Coach 健身产品测试用例 V1.0",
  "description": "业务流主线：账号准备（移动端注册/登录）→ 设备接入（启动/登录）→ 首次引导建档与 C00 校准 → 核心训练（首页/课程库/训练/记录）→ 智能助手（AI教练）→ 设置维护（个人中心/休眠）。模块内按测试点依赖链分组，组内保持原序（可用 sort_by_type 开启类型序）。",

  "stages": [
    {
      "name": "S1 账号准备（移动端）",
      "modules": ["移动端-注册", "移动端-登录"]
    },
    {
      "name": "S2 设备接入",
      "modules": ["设备端-启动", "设备端-登录"]
    },
    {
      "name": "S3 首次引导与基线校准",
      "modules": ["设备端-引导"]
    },
    {
      "name": "S4 核心训练闭环",
      "modules": ["设备端-首页", "设备端-训练课程库", "设备端-训练", "设备端-训练记录"]
    },
    {
      "name": "S5 智能助手",
      "modules": ["设备端-AI教练"]
    },
    {
      "name": "S6 设置维护与环境",
      "modules": ["设备端-个人中心", "设备端-休眠"]
    }
  ],

  "module_sequence": [
    "移动端-注册",
    "移动端-登录",
    "设备端-启动",
    "设备端-登录",
    "设备端-引导",
    "设备端-首页",
    "设备端-训练课程库",
    "设备端-训练",
    "设备端-训练记录",
    "设备端-AI教练",
    "设备端-个人中心",
    "设备端-休眠"
  ],

  "module_options": {
    "设备端-引导": { "fallback": "nearest" }
  },

  "testpoint_rules": {
    "移动端-注册": [
      { "group": "01 注册页入口与界面交互", "match": ["注册页基础UI", "注册页默认UI", "邮箱注册页UI", "注册页UI展示", "注册页标题", "注册页输入框占位", "注册页深色模式", "键盘弹起", "光标能自由移动", "密码明文切换", "输入内容能正确删除", "复制粘贴"] },
      { "group": "02 用户协议", "match": ["用户协议", "协议勾选", "未勾选协议", "勾选协议后允许注册"] },
      { "group": "03 注册按钮与提交控制", "match": ["注册按钮默认置灰", "注册按钮高亮", "注册按钮防重复提交", "注册页.注册.按钮", "注册页.开始注册.按钮", "注册页.<.按钮"] },
      { "group": "04 手机号注册主流程", "match": ["手机号输入合法", "手机号注册成功", "手机号自动去空格"] },
      { "group": "05 验证码获取与校验", "exclude": ["暴力破解", "发送次数限制", "触发限制", "超过5次锁定", "防刷", "接口"], "match": ["验证码", "倒计时"] },
      { "group": "06 手机号异常与边界", "match": ["手机号输入少于", "手机号输入超过", "手机号输入字母", "手机号输入特殊字符", "已注册手机号再次注册", "手机号已被注册", "空手机号"] },
      { "group": "07 密码规则校验", "match": ["密码必须包含字母和数字", "密码长度边界", "密码支持特殊字符", "弱密码拦截"] },
      { "group": "08 邮箱注册主流程", "match": ["邮箱输入合法格式", "邮箱注册成功", "邮箱输入国际邮箱", "邮箱输入子域名邮箱", "邮箱自动去空格", "邮箱自动转小写", "邮箱大小写一致性", "邮箱唯一性"] },
      { "group": "09 验证邮件发送与链接", "match": ["邮件发送", "邮件验证码", "邮件验证链接", "邮件重发", "邮件进入垃圾箱", "邮件标题", "邮件HTML", "邮件展示"] },
      { "group": "10 注册成功后的数据处理", "match": ["注册成功后自动登录", "注册成功后Token", "注册成功后Profile", "多设备邮件验证状态同步", "第三方登录Profile", "第三方登录Token同步", "第三方绑定表数据", "用户注销后邮箱可重新注册"] },
      { "group": "11 第三方注册-Google", "match": ["Google"] },
      { "group": "12 第三方账号绑定与换绑", "match": ["第三方账号自动绑定", "第三方换绑", "第三方解绑", "第三方账号解绑", "第三方账号绑定冲突", "第三方登录绑定已有账号", "第三方Token", "OAuth", "第三方身份伪造", "第三方登录"] },
      { "group": "13 设备端le授权注册", "match": ["设备端le"] },
      { "group": "14 输入异常与格式边界", "match": ["邮箱缺少@", "邮箱缺少域名", "邮箱输入超长", "邮箱输入emoji", "邮箱输入中文", "非法邮箱格式", "非法参数", "空参数"] },
      { "group": "15 安全与风控", "match": ["SQL注入", "XSS", "重放", "暴力破解", "Root设备", "VPN环境", "发送次数限制", "触发限制", "超过5次锁定", "防刷", "Token"] },
      { "group": "16 兼容性", "match": ["Android版本", "iOS版本", "小屏适配", "横竖屏"] },
      { "group": "17 弱网与无网", "match": ["弱网", "无网"] },
      { "group": "18 注册中断与恢复", "match": ["杀进程", "切后台"] },
      { "group": "19 埋点与日志", "match": ["埋点", "日志"] },
      { "group": "20 接口与幂等", "match": ["注册接口"] },
      { "group": "21 性能与并发", "match": ["页面加载性能", "高并发", "并发"] }
    ],

    "移动端-登录": [
      { "group": "01 登录页界面展示", "match": ["登录页默认UI", "登录页标题", "登录页输入框占位", "登录页.开始登录.按钮", "登录成功弹窗UI", "登录成功弹窗$"] },
      { "group": "02 输入控件与页面交互", "match": ["密码输入框长度限制", "邮箱输入框长度限制", "粘贴功能", "返回按钮逻辑", "键盘弹起", "登录按钮点击态", "我知道了", "输入特殊字符"] },
      { "group": "03 用户协议", "match": ["协议链接跳转", "登录页协议勾选", "未勾选协议"] },
      { "group": "04 注册入口（登录页内跳转）", "match": ["注册页", "注册按钮禁用态", "欢迎页头像"] },
      { "group": "05 手机号密码登录主流程", "match": ["正确手机号正确密码登录", "手机号登录登录成功", "token保存", "退出登录token失效", "手机号登录密码加密传输"] },
      { "group": "06 手机号登录异常与边界", "match": ["手机号位数", "手机号包含", "手机号登录密码为空", "密码包含空格", "密码最大长度", "密码最小长度", "空手机号", "正确手机号错误密码", "错误密码登录失败", "连续输错密码锁定", "账号密码错误超过5次锁定", "重复输入错误密码", "输入特殊字符", "未注册手机号"] },
      { "group": "07 验证码登录", "exclude": ["防刷", "接口", "高并发", "忘记", "重置"], "match": ["验证码"] },
      { "group": "08 邮箱登录", "match": ["邮箱登录", "空邮箱", "未注册邮箱", "非法邮箱格式", "邮箱前后空格", "邮箱大小写兼容", "邮箱输入"] },
      { "group": "09 第三方与快捷登录", "match": ["Google", "QQ登录", "微信登录", "一键登录", "双卡", "无SIM卡", "飞行模式", "运营商", "设备端le", "第三方"] },
      { "group": "10 登录异常与安全提醒", "match": ["登录弱网", "断网登录", "异地登录", "会话超时", "登录超时"] },
      { "group": "11 忘记密码与重置", "match": ["忘记密码", "重置密码", "新旧密码一致", "密码复杂度", "验证码重置", "错误验证码重置"] },
      { "group": "12 安全与风控", "match": ["Cookie安全", "SQL注入", "XSS", "抓包篡改", "接口越权", "日志不记录", "暴力破解", "重放攻击", "设备风控", "登录设备数量", "多设备登录限制", "验证码防刷", "接口防刷", "验证码接口响应", "高并发验证码"] },
      { "group": "13 兼容性", "match": ["Android不同版本", "iOS不同版本", "不同分辨率", "不同网络环境", "刘海屏", "多语言", "平板设备", "折叠屏", "深色模式", "横竖屏"] },
      { "group": "14 性能与稳定性", "match": ["冷启动", "登录接口响应", "高并发", "内存泄漏", "耗电量", "长时间稳定性"] }
    ],

    "设备端-启动": [
      { "group": "01 进入启动流程", "match": ["设备端进入功能", "点击启动按钮后进入启动页"] },
      { "group": "02 开机动画与展示", "match": ["开机动画", "纯展示"] },
      { "group": "03 启动页UI元素", "match": ["UI元素存在性", "加载图标", "图片加载", "标题文本"] },
      { "group": "04 版本检查与强制更新", "match": ["版本检查", "强制更新"] },
      { "group": "05 启动跳转", "match": ["启动功能验证", "启动按钮"] }
    ],

    "设备端-登录": [
      { "group": "01 开机进入登录界面", "match": ["开机自动进入账号登录界面", "二维码刷新时间"] },
      { "group": "02 登录二维码展示", "match": ["登录账号界面二维码区域", "登录账号界面主标题", "登录账号界面二维码倒计时", "登录账号界面websocket", "登录账号界面跳转流畅"] },
      { "group": "03 扫码与二维码有效期", "match": ["二维码扫描跳转成功", "二维码超时跳转", "不能重复扫码", "扫描失效二维码", "多手机扫码同一二维码", "高频刷新二维码"] },
      { "group": "04 二维码失效界面", "match": ["二维码失效界面", "刷新二维码"] },
      { "group": "05 等待中界面", "match": ["等待中界面", "等待界面", "重新登录"] },
      { "group": "06 登录中界面", "match": ["账号登陆中界面", "账号登录中界面"] },
      { "group": "07 登录超时界面", "match": ["登录超时界面"] },
      { "group": "08 登录异常界面", "priority": 10, "match": ["登录异常界面", "登录异常.重试"] },
      { "group": "09 登录成功与跳转", "match": ["登录成功界面", "登录成功跳转首页", "自动同步用户信息"] },
      { "group": "10 自动登录", "match": ["自动登录"] },
      { "group": "11 账号状态与页面恢复", "match": ["用户冻结", "页面丢失恢复", "登录态过期", "多设备同时扫码", "用户退出后"] },
      { "group": "12 网络异常与异常响应", "match": ["弱网扫码", "网络断开重连", "服务端500"] },
      { "group": "13 多语言", "match": ["多语言"] }
    ],

    "设备端-引导": [
      { "group": "01 首次建档-开始方式", "match": ["首次建档-开始方式", "首次进入自动展示首次建档"] },
      { "group": "02 首次建档-基础信息", "match": ["首次建档-基础信息", "中断-基础信息", "男生选择", "女生选择", "保密选择", "性别", "出生日期", "出生年月", "单位栏", "单位选择", "单位切换", "单位无法", "公制选择", "英制选择", "未选择单位", "信息栏", "信息选择栏", "信息选择确认", "身高设置", "身高低于", "身高超过", "体重设置", "体重边界", "未填写信息", "上次填写的选项"] },
      { "group": "03 首次建档-当前能力", "match": ["首次建档-当前能力", "当前能力界面", "运动次数", "运动时长"] },
      { "group": "04 首次建档-节奏与方向", "match": ["节奏与方向", "当前状态栏", "训练次数栏", "训练时长栏", "已保存的内容能正常进行修改"] },
      { "group": "05 开始方式-首次校准入口", "match": ["开始方式-首次校准"] },
      { "group": "06 校准前准备与就绪检查", "match": ["校准前准备"] },
      { "group": "07 安全确认（筛查问卷）", "match": ["安全确认"] },
      { "group": "08 筛查不通过-暂停训练", "priority": 10, "match": ["开始运动前确认-暂停训练", "暂停训练界面"] },
      { "group": "09 开始跑步校准提醒", "match": ["开始跑步校准提醒"] },
      { "group": "10 校准倒计时与实时引导", "match": ["倒计时界面"] },
      { "group": "11 心率区间与年龄算法", "match": ["年龄计算", "年龄上限", "最低年龄", "高龄边界", "心率区间", "心率比例", "宽区间"] },
      { "group": "12 身高档位与速度派生", "match": ["身高158", "身高159", "身高160", "身高161", "身高179", "身高180", "身高181"] },
      { "group": "13 锚点派生与速度封顶", "match": ["锚点派生", "封顶", "由舒适走", "由快走", "锚点", "上限由", "短跑探测速度", "BW18", "CW14"] },
      { "group": "14 课程时间轴与动作序列", "match": ["S1", "S2", "S3", "课时间轴", "热身段", "回落段", "放松段", "课程时长", "阶段切换", "动作顺序", "整节结束采一次RPE", "RPE不回改"] },
      { "group": "15 20秒窗口判定与速度控制", "match": ["20秒", "窗口", "平均心率", "低于下限", "从下限开始", "区间内", "高于上限", "加速", "减速", "上限保持", "速度上限", "步进0.2", "多窗口", "不采RPE", "无RPE", "RPE参与判定", "无额外最终确认", "达到时长上限", "无心率数据", "单点心率", "低于区间速度", "高于区间速度", "最高速度恰在边界", "最低有效速度"] },
      { "group": "16 暂停规则与重测", "priority": 10, "match": ["暂停立即停机", "暂停超2次", "恰好2次", "3次", "暂停取消", "暂停发生在"] },
      { "group": "17 降速规则", "match": ["降速"] },
      { "group": "18 安全停止", "match": ["安全停止", "安全关闭后"] },
      { "group": "19 通过/未通过判定", "match": ["未通过", "五条件", "动作结果集", "结果固定通过", "对外仅展示", "内部保留未通过原因", "原因分类", "通过需最高速度锚点"] },
      { "group": "20 能力阶段调整", "match": ["能力阶段", "decision", "保持", "下调", "S4", "判断顺序先中断", "三类输出同节一致", "不输出额外状态字段", "C00不输出升级", "全通过走第三步"] },
      { "group": "21 重测触发", "match": ["必重测", "重测"] },
      { "group": "22 端到端流程复现", "match": ["happy路径", "端到端", "完整PRD示例复现", "彩屏与后台数据一致", "首次校准-校准已完成界面.*点击.确认"] },
      { "group": "23 校准已完成", "match": ["校准已完成"] },
      { "group": "24 训练计划生成", "match": ["计划生成界面", "计划生成-开始方式"] },
      { "group": "25 确认训练计划", "match": ["确认训练计划", "修改目标", "修改后的计划", "修改界面修改内容", "稍后再说"] },
      { "group": "26 完成引导", "match": ["完成引导生成计划", "已完成引导不再进入欢迎页"] }
    ],

    "设备端-首页": [
      { "group": "01 首页加载与数据恢复", "match": ["首页Loading", "服务端同步数据恢复", "首页弱网加载", "长时间挂机"] },
      { "group": "02 顶部功能入口", "match": ["顶部按钮默认状态", "语音助手", "蓝牙设备按钮", "提醒按钮", "用户头像"] },
      { "group": "03 训练计划栏-开始训练", "exclude": ["异常结束", "查看四周计划"], "match": ["开始训练.状态", "开始训练按钮"] },
      { "group": "04 开始运动前确认（运动筛查）", "priority": 10, "match": ["开始运动前确认", "有疼痛", "确认提交"] },
      { "group": "05 本周训练计划查看", "match": ["本周训练"] },
      { "group": "06 四周训练计划查看", "match": ["四周训练"] },
      { "group": "07 训练计划栏-已完成", "match": ["已完成.状态", "查看四周计划"] },
      { "group": "08 训练计划栏-继续训练", "match": ["继续训练"] },
      { "group": "09 训练计划栏-异常结束重新开始", "match": ["异常结束"] },
      { "group": "10 训练计划栏-休息日", "match": ["休息日"] },
      { "group": "11 训练计划栏-计划生成失败", "match": ["计划生成失败"] },
      { "group": "12 训练计划栏-筛查未通过", "match": ["筛查未通过"] },
      { "group": "13 训练计划栏-离线", "match": ["离线"] },
      { "group": "14 推荐原因栏", "match": ["推荐原因"] },
      { "group": "15 计划详情栏", "match": ["计划详情栏"] },
      { "group": "16 日历栏", "match": ["日历栏", "日历日期"] },
      { "group": "17 课程库入口", "match": ["课程库"] },
      { "group": "18 训练记录入口", "match": ["训练记录"] },
      { "group": "19 多次超时与状态聚合", "match": ["两次及以上训练超时"] }
    ],

    "设备端-训练课程库": [
      { "group": "01 进入课程库与页面框架", "match": ["课程库界面UI展示", "默认焦点位置", "点击返回按钮界面跳转至首页"] },
      { "group": "02 力量/有氧Tab切换", "match": ["Tab栏"] },
      { "group": "03 时间筛选", "match": ["时间.选项栏", "时间范围选择"] },
