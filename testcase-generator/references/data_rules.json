{
  "_说明": "测试数据校验规则库模板。复制到项目里按真实字段约束填写，用 score_testcases.py --rules 传入。默认与内置规则【合并】，只写项目特有的字段即可。",
  "_支持的类型": {
    "phone": "正则匹配 —— {type, pattern, hint}",
    "amount": "数值下限 + 小数位上限 —— {type, min, decimals, hint}",
    "range": "数值闭区间 —— {type, min, max, hint}",
    "length": "字符串长度闭区间 —— {type, min, max, hint}",
    "regex": "任意正则 —— {type, pattern, hint}",
    "enum": "枚举白名单 —— {type, values, hint}"
  },
  "_示例_内置三条": {
    "手机号": { "type": "phone", "pattern": "^1\\d{10}$", "hint": "11 位数字" },
    "订单金额": { "type": "amount", "min": 0.01, "decimals": 2, "hint": ">=0.01 且 2 位小数" },
    "用户等级": { "type": "enum", "values": ["普通", "VIP", "SVIP"], "hint": "只能取 普通/VIP/SVIP" }
  },

  "手机号": { "type": "phone", "pattern": "^1[3-9]\\d{9}$", "hint": "11 位手机号（1 开头，第二位 3-9）" },
  "订单金额": { "type": "amount", "min": 0.01, "decimals": 2, "hint": ">=0.01 的数值，保留 2 位小数" },
  "用户等级": { "type": "enum", "values": ["普通", "VIP", "SVIP"], "hint": "只能取 普通/VIP/SVIP" },

  "验证码": { "type": "length", "min": 6, "max": 6, "hint": "固定 6 位数字" },
  "助力档位": { "type": "range", "min": 0, "max": 5, "hint": "0~5 档，0=无助力，5=最高" },
  "SOC": { "type": "range", "min": 0, "max": 100, "hint": "电量百分比 0~100" },
  "实时车速": { "type": "range", "min": 0, "max": 99.9, "hint": "单位 km/h，上限 99.9" },
  "MAC地址": { "type": "regex", "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$", "hint": "6 组冒号分隔十六进制" }
}
